<?xml version="1.0" encoding="utf-8"?>
<!-- National Parks Schema  which tells us what tags are allowed, what order they should come in, and which attributes they must have vs optional (I looked at the Figure 1 for specifications on the Assignment 4 doc)-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- The first rule is that the outermost tag has to be "NationalParks"-->  
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
        <!-- The second rule is that inside the NationalParks tag, we can have as much <NationalPark> elements as we want -->
        <xs:element name="NationalPark" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!--Inside the NationalPark tag we have one name which would be a string-->
              <xs:element name="Name" type="xs:string"/>
              <!--Inside the NationalPark tag we also have one or more phone numbers which would also be a string-->
              <xs:element name="Phone" type="xs:string" maxOccurs="unbounded"/>
              <!--Inside the NationalPark tag we also have one address which has its own tags inside of it (Number, Street, City, State, Zip in this order)-->
              <xs:element name="Address">
                <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Number" type="xs:int"/>
                      <xs:element name="Street" type="xs:string"/>
                      <xs:element name="City" type="xs:string"/>
                      <xs:element name="State" type="xs:string"/>
                      <xs:element name="Zip" type="xs:string"/>
                    </xs:sequence>

                    <!-- Also, each address tag will have a NearestAirport attribute -->
                    <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <!-- Each NationalPark tag may also have a Rating attribute which is optional and it is stored as a decimal number-->
            <xs:attribute name="Rating" type="xs:decimal" use="optional"/>

          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>